# --- HTTP ---------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Human-readable logs (dev only; requires the pino-pretty dev dependency)
LOG_PRETTY=false

# --- Storage ------------------------------------------------------------------
DATABASE_PATH=./data/content-sync.db

# --- Upstream -----------------------------------------------------------------
UPSTREAM_BASE_URL=https://jsonplaceholder.typicode.com
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_MAX_RETRIES=3
UPSTREAM_RATE_LIMIT_RPS=5
UPSTREAM_RATE_LIMIT_BURST=10

# --- Workers / queue ----------------------------------------------------------
WORKERS_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=500
JOB_LEASE_MS=30000
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=60000

# --- Scheduler (0 disables a schedule) ----------------------------------------
SCHEDULER_ENABLED=true
INCREMENTAL_SYNC_INTERVAL_MS=300000
FULL_SYNC_INTERVAL_MS=3600000

# --- Lifecycle ----------------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=15000
